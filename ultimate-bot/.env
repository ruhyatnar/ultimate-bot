# =================================================================
# BINANCE ULTIMATE BOT — ENVIRONMENT CONFIGURATION
# =================================================================

# --- Trading Mode ---
# Set to 'true' for zero-risk paper simulation with real-time market data
# Set to 'false' for live trading with real funds
PAPER_TRADE=true

# Use Binance Spot Testnet (testnet.binance.vision) if desired
USE_TESTNET=false

# --- Binance API & Ed25519 Authentication ---
# Required for LIVE trading. Whitelist your VPS IP in the Binance API settings!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_PRIVATE_KEY_PATH=./keys/private_key.pem

# --- Strategy Preset ---
# Options: 'scalping' (1m/15m), 'day' (5m/1h), 'swing' (15m/4h)
PRESET=day

# --- Symbol Configuration ---
# STATIC_SYMBOLS: comma-separated pairs to monitor
STATIC_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
# DYNAMIC_SYMBOLS: if true, uses top momentum/volatility pairs (overrides static list)
DYNAMIC_SYMBOLS=false
MAX_SYMBOLS=5
QUOTE_ASSET=USDT
EXCLUDE_SYMBOLS=USDC,BUSD,FDUSD,TUSD,UP,DOWN

# --- Signal Confluence Engine ---
# Minimum confluence score required to execute a MARKET BUY (range: 1 to 5)
# 1 = Trend (HTF EMA + LTF EMA)
# 2 = Market Structure Break of Structure (BOS)
# 3 = Fair Value Gap (FVG)
# 4 = Cumulative Volume Delta (CVD) Bullish Inflow
# 5 = Point of Control (POC) Volume Support
SIGNAL_THRESHOLD=4

# How often (seconds) each symbol is analyzed for entry signals
SIGNAL_INTERVAL=10

# --- Risk & Portfolio Management ---
# Total equity usage across all positions (0.5 = max 50% of available balance)
BALANCE_USAGE_PERCENT=0.5
# Maximum equity allocated to any single trade (0.2 = max 20%)
MAX_SYMBOL_ALLOCATION_PERCENT=0.2
# Maximum daily loss threshold before trading pauses (0.05 = 5% daily drawdown)
MAX_DAILY_DRAWDOWN=0.05

# Cooldown streaks
MAX_LOSS_STREAK=3
COOLDOWN_LOSS=3600
MAX_WIN_STREAK=5
COOLDOWN_WIN=1800

# Slippage protection
MAX_SLIPPAGE_PERCENT=0.5
MIN_TP_PERCENT=0.005

# --- Database & Storage ---
DB_PATH=./data/trading.db

# --- Discord Webhook Notifications (Optional) ---
DISCORD_WEBHOOK_URL=
DISCORD_COOLDOWN=30

# --- Logging & Health ---
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log
HEALTH_CHECK_INTERVAL=60
REST_WEIGHT_LIMIT=1200
AUTO_LIQUIDATE_ORPHANS=false
