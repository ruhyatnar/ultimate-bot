# =================================================================
# BINANCE ULTIMATE BOT — ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and edit. The engine (main.py) and the web monitor
# (status.py) both read this file. The interactive dashboard can also push tuned
# values to .env via POST /api/config (whitelist-only, never credentials).
#
# Run `python3 status.py` to print a live status snapshot, or `python3 status.py
# --web 3000` to serve the dashboard + HTTP API on port 3000.
# =================================================================

# --- Trading Mode ---
# 'true' = zero-risk paper simulation (recommended for first 24-48h on a new VPS).
# 'false' = live trading with real funds. The engine will refuse to start in live
# mode unless BINANCE_API_KEY + (BINANCE_API_SECRET or BINANCE_PRIVATE_KEY_PATH) are
# configured and the Ed25519/HMAC setup steps in the README have been completed.
PAPER_TRADE=true

# Binance Spot Testnet (testnet.binance.vision) if desired
USE_TESTNET=false

# --- Binance API & Ed25519 Authentication ---
# Required for LIVE trading. Whitelist your VPS IP in the Binance API settings.
BINANCE_API_KEY=your_binance_api_key_here
# Standard HMAC-SHA256 secret (alternative to the Ed25519 private key below).
BINANCE_API_SECRET=
# Ed25519 asymmetric private key path (preferred for live trading).
# Generate with: openssl genpkey -algorithm Ed25519 -out ./keys/private_key.pem
# Extract the public key with: openssl pkey -in ./keys/private_key.pem -pubout
BINANCE_PRIVATE_KEY_PATH=./keys/private_key.pem

# --- Strategy Preset ---
# Built-in profiles: 'scalping' (1m/15m), 'day' (5m/1h), 'swing' (15m/4h),
# 'swing_rsi' (5m/1d RSI-dip swing, +52.4% PF 2.11) and 'intraday_rsi'
# (5m/1d RSI-dip intraday, +33.6% engine-parity PF 1.82 — the proven $22
# daytrading config). Individual keys below override the preset when set.
PRESET=intraday_rsi

# --- rsi_dip Strategy Mode (swing_rsi / intraday_rsi presets) ---
# STRATEGY_MODE=rsi_dip switches the signal engine from the 5-factor confluence
# score to the backtest-proven pullback strategy: daily EMA-50 regime gate
# (last COMPLETED daily candle above a rising EMA-50) + RSI(RSI_PERIOD) dip
# trigger (RSI < RSI_OVERSOLD and turning up, sampled once per RSI_TIMEFRAME
# bucket). Exits use a FIXED % bracket instead of ATR: SL at entry*(1-SL_PERCENT),
# TP at entry*(1+TP_PERCENT) as a resting OCO limit (maker fee).
# MAX_TRADES_PER_DAY caps entries per UTC day (the binding frequency limiter).
#
# RSI_SOURCE selects how the RSI series is computed:
#   'ltf' = RSI on the 5m close series, sampled at each bucket's last closed
#          bar (intraday_rsi convention — a ~35min-lookback signal read hourly).
#   'htf' = RSI on dedicated RSI_TIMEFRAME bucket closes (swing_rsi convention).
#
# BREAKEVEN_ENABLED gates the +1% breakeven stop lock. Proven OFF for
# intraday_rsi (the lock exits the trade long before the +3% TP). Keep OFF.
# CLOSE_AT_UTC_DAY_END=true force-closes any open position at UTC day end
# (intraday discipline: no overnight holds, same-day re-entry allowed).
#
# Proven configs (2026-09-10/11 research campaigns, ~$22 equity):
#   intraday_rsi: NEARUSDT +41.6% lab / +33.6% engine-parity (PF 1.82, WR 47%,
#                 66 trades, max DD 8.1%), all 3 sub-windows positive.
#   swing_rsi:    NEARUSDT +52.4% (PF 2.11, WR 55.3%, 38 trades, max DD 6.5%).
# The tested edges used NO scale-out and a pure SL/TP bracket, so
# SCALE_OUT_ENABLED ships false for rsi_dip presets.
STRATEGY_MODE=rsi_dip
SL_PERCENT=0.012
TP_PERCENT=0.03
RSI_PERIOD=7
RSI_OVERSOLD=40
RSI_TIMEFRAME=1h
RSI_TIMEFRAME_MS=3600000
RSI_SOURCE=ltf
BREAKEVEN_ENABLED=false
CLOSE_AT_UTC_DAY_END=true
REGIME_EMA=50
REGIME_SLOPE_DAYS=3
MAX_TRADES_PER_DAY=1

# --- Symbol Configuration ---
# Comma-separated pairs to monitor in static mode. The intraday_rsi edge is
# PAIR-CONCENTRATED (9-pair rotation degraded to +14.6%, PF 1.07) — ship it
# pinned to NEARUSDT.
STATIC_SYMBOLS=NEARUSDT
# When true, the scanner ranks candidates by a 4-factor Z-score (volume, 24h change,
# volatility, ADX) with a correlation penalty and picks the top MAX_SYMBOLS.
DYNAMIC_SYMBOLS=false
# Maximum concurrent positions (static or dynamic).
MAX_SYMBOLS=1

# --- NOTIONAL / position-size research gates (off by default) ---
# These are research knobs used by backtest.py sweeps; they are NOT read by the
# live engine unless you explicitly set them. Keep commented unless you are A/B
# testing a specific filter on historical data.
#MIN_NOTIONAL=10.0            # Binance spot minNotional floor (USDT) below which a trade can't be placed
#BB_LOWER_PCT_B=0.0           # research: skip entries whose Bollinger %%B <= this (falling-knife gate)
#LTF_ADX_MIN=0.0              # research: skip entries when the execution-TF ADX(14) < this (chop gate)
#SIGNAL_VOL_MULT=0.0          # research: require signal-bar volume >= this multiple of the 20-bar avg
#BE_TRIGGER_R=0.0             # research: breakeven lock triggers at this R-multiple (default: +1%% of price)
#TRAIL_ACTIVATE_R=0.0         # research: trailing stop activates at this R-multiple (default: TRAILING_STOP_ACTIVATE)
#MAKER_TP=false               # research: TP exits pay maker fee 0.02%% (OCO limit leg) instead of taker 0.1%%
#EQUITY=1000.0                # research: override starting equity for backtests (default 1000 USDT)
# Quote asset suffix — everything is traded against this (default USDT).
QUOTE_ASSET=USDT
# Base-asset names to exclude from the dynamic screener. Matched on the base-asset
# boundary only (exact match or leveraged suffixes like BTCUP), so real pairs whose
# ticker merely contains those letters (e.g. SUPERUSDT) are not wrongly dropped.
EXCLUDE_SYMBOLS=USDC,BUSD,FDUSD,TUSD,UP,DOWN

# --- Risk Model & Trade Management (professional defaults) ---
# Fixed-fractional risk sizing: each trade risks exactly RISK_PER_TRADE of total
# equity between entry and stop, regardless of how wide the ATR stop is.
# 0.01 = 1% of equity per trade. The notional caps (BALANCE_USAGE_PERCENT /
# MAX_SYMBOL_ALLOCATION_PERCENT) still act as secondary ceilings.
RISK_PER_TRADE=0.01
# Minimum reward-to-risk at entry: TP distance must be >= this multiple of the SL
# distance. Entries below the bar are widened to it or skipped.
MIN_RISK_REWARD=1.5
# Scale-out: when the position reaches SCALE_OUT_R_MULTIPLE x the initial stop
# distance in profit, sell SCALE_OUT_FRACTION of it (banking partial profit), lock
# breakeven on the remainder, and let the runner ride to the full TP.
# NOTE: the proven swing_rsi (rsi_dip) edge was tested WITHOUT scale-out — the
# tested TP was a resting OCO limit that exits the full position in one leg.
# Keep this ON for the confluence presets (day/scalping/swing); set to false for
# rsi_dip if you want to mirror the proven config exactly.
# rsi_dip edges were proven WITHOUT scale-out; set true only for ATR presets
SCALE_OUT_ENABLED=false
SCALE_OUT_R_MULTIPLE=1.0
SCALE_OUT_FRACTION=0.5

# --- Signal Confluence Engine ---
# Minimum independent factors that must align to open a MARKET BUY (1-5).
#   1. HTF trend: MTF EMA-50 above/below EMA-200
#   2. Break of Structure (BOS): price breaking prior swing high/low
#   3. Fair Value Gap (FVG): 3-candle displacement gap on the last closed candles
#   4. Cumulative Volume Delta (CVD): 20-bar taker-buying inflow
#   5. Point of Control (POC): price relative to the 20-candle volume POC
# SELL confluence is computed for symmetry but NEVER executed (spot long-only).
SIGNAL_THRESHOLD=3

# How often (seconds) each symbol is analyzed for entry signals.
SIGNAL_INTERVAL=6

# --- Multi-Timeframe & Trend Detection ---
# Lower-timeframe candles used for entries / signal factors.
TIMEFRAME=5m
# Higher-timeframe candles used for the HTF EMA trend filter.
MTF_TIMEFRAME=1h
# ATR period (in candles) for stop / take-profit sizing.
ATR_PERIOD=14
# ATR multiplier for the initial stop loss (e.g. 3.0 = 3.0x ATR below entry).
# 3.0 is backtest-proven on 5m BTC: wide stop -> fewer noise stop-outs.
ATR_MULTIPLIER_SL=3.0
# ATR multiplier for the initial take profit (must be > ATR_MULTIPLIER_SL).
ATR_MULTIPLIER_TP=3.5

# --- rsi_dip % Bracket (used only when STRATEGY_MODE=rsi_dip) ---
# These are % of entry price, NOT ATR multiples. In rsi_dip mode the ATR
# multipliers above are IGNORED; SL/TP come from SL_PERCENT / TP_PERCENT.
#MIN_TP_PERCENT=0.04
# Profit % (of entry) needed before the trailing stop is armed.
TRAILING_STOP_ACTIVATE=0.015
# Trailing-stop callback: stop follows price up by this % of price.
TRAILING_STOP_CALLBACK=0.005
# Lookback (in candles) for swing-high/low detection used by BOS.
SWING_LOOKBACK=5
# Max hold time in seconds before a TIME_STOP closes the trade (0 = disabled).
# intraday_rsi: 84600s (23.5h) — positions never survive past the EOD close anyway
MAX_HOLD_TIME=84600

# --- Bollinger Band Overextension Gate ---
# Bollinger Bands %B position gauge: (close - lower) / (upper - lower) over the
# last BB_PERIOD closed candles. All five confluence factors are momentum
# signals, so the engine additionally REFUSES to BUY when price is statistically
# stretched (%B >= BB_UPPER_PCT_B, default 0.95 = at/above the upper band with
# BB_STD_DEV deviations). Such vertical entries mean-revert into the ATR stop
# before the take-profit fires. Set BB_STRETCH_GATE_ENABLED=false to disable.
BB_PERIOD=20
BB_STD_DEV=2.0
BB_UPPER_PCT_B=0.95
BB_STRETCH_GATE_ENABLED=true

# --- rsi_dip: Bollinger gate is OFF in the proven config ---
# The tested rsi_dip edge did NOT use the BB stretch gate (it buys dips, which
# by definition often print near the lower band). When STRATEGY_MODE=rsi_dip,
# the engine disables BB_STRETCH_GATE_ENABLED by default. Uncomment the line
# below only if you want to keep the gate active in rsi_dip mode.
#BB_STRETCH_GATE_ENABLED=false

# --- Risk & Portfolio Management ---
# Max % of total equity deployable across ALL positions at once (0.5 = 50%).
BALANCE_USAGE_PERCENT=0.5
# Max % of equity allocatable to a SINGLE position (0.2 = 20%).
MAX_SYMBOL_ALLOCATION_PERCENT=0.2
# Daily drawdown limit: trading blocks new entries when realized + unrealized PnL
# drops below -MAX_DAILY_DRAWDOWN * equity. Resets at UTC midnight.
MAX_DAILY_DRAWDOWN=0.05
# Streak-based cooldowns (mirrors the web monitor's cooldown banner).
MAX_LOSS_STREAK=3
# Backtest-proven: 3h cooldown after a 3-loss streak cut overtrading and
# improved profit factor 0.49 -> 0.79 on 5m BTC.
COOLDOWN_LOSS=3600
MAX_WIN_STREAK=5
COOLDOWN_WIN=1800

# Slippage protection: skip entry if live price moved > MAX_SLIPPAGE_PERCENT from
# the expected entry price at order time.
MAX_SLIPPAGE_PERCENT=0.5
# Minimum take-profit distance as % of entry (prevents TP too close to SL).
# Backtest-proven 0.15% on 5m: the old 0.5% floor made TP ~8x wider than the
# ATR stop, so nearly every trade resolved as a -1R stop-out.
# TP floor — matches the intraday_rsi +3% TP bracket
MIN_TP_PERCENT=0.03

# --- rsi_dip TP floor (overrides MIN_TP_PERCENT when STRATEGY_MODE=rsi_dip) ---
# The proven rsi_dip edge used a FIXED +4% TP, so the minimum TP is set to 4%
# in that mode (the engine picks the larger of MIN_TP_PERCENT and TP_PERCENT).
# Leave commented to keep the confluence presets at 0.15%.
#MIN_TP_PERCENT=0.04

# --- Screener / ADX ---
# Minimum 24h quote-volume (USDT) for a symbol to enter the dynamic screener.
MIN_VOLUME_USDT=1000000
# Minimum 24h price-change % (absolute) for the screener.
MIN_PRICE_CHANGE_PERCENT=0.5
# Minimum 24h volatility % (high-low / last) for the screener.
MIN_VOLATILITY_PERCENT=0.3
# ADX threshold: symbols below this are dropped from the dynamic screen.
ADX_THRESHOLD=25
# ADX lookback period.
ADX_PERIOD=14
# How many top candidates the screener fetches before Z-scoring.
TOP_CANDIDATES=50
# How often (seconds) the dynamic symbol list is refreshed.
SYMBOL_REFRESH_INTERVAL=3600
# Z-score factor weights (must sum to 1.0 for a normalized composite).
Z_SCORE_WEIGHT_VOLUME=0.20
Z_SCORE_WEIGHT_CHANGE=0.20
Z_SCORE_WEIGHT_VOLATILITY=0.20
Z_SCORE_WEIGHT_ADX=0.40
# Correlation penalty: correlated pairs above CORRELATION_THRESHOLD lose this fraction
# of their Z-score so the basket stays diversified.
CORRELATION_THRESHOLD=0.70
CORRELATION_PENALTY=0.90
# Lookback (bars) for trend-direction / breakout context in the screener.
TREND_LOOKBACK=20

# --- Database & Storage ---
DB_PATH=./data/trading.db
# File the web monitor writes one-shot close_all / close_symbol commands to; the
# engine polls it every cycle. Supports pause/resume and emergency closes from the
# web dashboard without SSH.
CONTROL_FILE=./data/engine_control.json

# --- Discord Webhook Notifications (Optional) ---
DISCORD_WEBHOOK_URL=
DISCORD_COOLDOWN=30

# --- Logging & Health ---
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log
HEALTH_CHECK_INTERVAL=60
REST_WEIGHT_LIMIT=1200
ENTRY_TIMEOUT=15
# If false, existing spot balances in your wallet are left completely untouched
# (orphan positions are only reported, not auto-closed).
AUTO_LIQUIDATE_ORPHANS=false
# Hours to look back when re-adopting an orphaned bot fill as a managed position (trade_logic orphan adoption).
ORPHAN_ADOPT_WINDOW_HOURS=48

# --- Backtest-only flags (not read by the live engine) ---
# These are consumed by backtest.py only; they have no effect on main.py.
# Pages = number of 1000-bar pages to fetch per backtest run.
#BACKTEST_PAGES=3
#BACKTEST_SYMBOL=BTCUSDT
#BACKTEST_PRESET=day
#BACKTEST_END_TIME=
#BACKTEST_DISABLE_BB=false
#BACKTEST_THRESHOLD=
#BACKTEST_SL_MULT=
#BACKTEST_TP_MULT=
#BACKTEST_SCALE_FRAC=
#BACKTEST_BB_PCTB=
#BACKTEST_COOLDOWN_BARS=
#BACKTEST_MIN_TP=
#BACKTEST_BB_LOWER=
#BACKTEST_ADX_MIN=
#BACKTEST_VOL_MULT=
#BACKTEST_BE_R=
#BACKTEST_TRAIL_R=
#BACKTEST_MAX_HOLD=
#BACKTEST_MAKER_TP=false
#BACKTEST_NO_SCALE_OUT=false
#BACKTEST_MIN_NOTIONAL=
#BACKTEST_EQUITY=
#BACKTEST_BALANCE_USAGE_PERCENT=
#BACKTEST_MAX_SYMBOL_ALLOCATION_PERCENT=
#BACKTEST_QUIET=false
